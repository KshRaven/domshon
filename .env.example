# Domshon server settings. Copy to .env (or set real environment variables).
# Precedence (lowest -> highest): defaults < process env < .env file < settings.json
# settings.json is written by the admin GUI / CLI / API. The server re-reads .env and
# settings.json automatically (within ~1s) so most of these apply LIVE, no restart.
# Restart required only for: DS_HOST, DS_PORT, DS_TRUST_PROXY, DS_SECRET_KEY.

DS_HOST=0.0.0.0
DS_PORT=8787
# Public domain you point at this server (used by the nginx proxy/https Docker profiles; reported to clients)
DS_DOMAIN=files.example.com
# Set true when running behind nginx so real client IPs reach the login rate limiter
DS_TRUST_PROXY=false

# Default storage location (leave empty for the per-OS app data dir)
DS_STORAGE_ROOT=
# Extra server folders clients may sync with: name=/abs/path;other=/abs/path  (or JSON object)
DS_MOUNTS=

# Admin account. Password is hashed into settings.json on first start. If neither
# is set a random password is generated and printed once.
DS_ADMIN_USER=admin
DS_ADMIN_PASSWORD=
# Or a pre-hashed value: run `domshon server passwd`
DS_ADMIN_PASSWORD_HASH=

# Optional fixed signing key (otherwise generated into the config dir as secret.key)
DS_SECRET_KEY=

DS_MAX_UPLOAD_MB=0

# ---- Disk space the cloud may use (all live; 0 = off / unlimited) -----------
# Cap for the main storage folder, in MB. Mounted extra folders are not counted.
DS_QUOTA_MB=0
# Always keep at least this many MB of the whole disk free (protects a small host)
DS_MIN_FREE_MB=0
# File types that may not be stored, e.g. .exe,.php
DS_BLOCKED_EXTENSIONS=
# false = only the admin can upload / change files; device users become read-only
DS_USER_WRITES=true
DS_SESSION_HOURS=12
# Live security switches
DS_READ_ONLY=false
DS_LOCKDOWN=false

# Where server config (settings.json, tokens.json, secret.key) lives
DS_CONFIG_DIR=

# ---- Docker compose only -------------------------------------------------
# Interface the container port is published on (127.0.0.1 = local only, use with the nginx profiles)
DS_BIND=127.0.0.1
DS_PUBLISH_PORT=8787
# Using the proxy or https profile? Also set DS_DOMAIN above and DS_TRUST_PROXY=true.
